generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// ------------------------------------------------------------------
/// Kimlik (NextAuth)
/// ------------------------------------------------------------------

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String?   @unique
  emailVerified      DateTime?
  image              String?
  password           String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  preferredTransport String?   @default("all")
  preferredCurrency  String?   @default("TRY")
  interests          String?
  preferences        Json?

  accounts Account[]
  sessions Session[]
  plans    Plan[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// ------------------------------------------------------------------
/// Seyahat planı
/// ------------------------------------------------------------------

enum PlanSource {
  AI
  MANUAL
}

/// PLANNED/CANCELLED/DONE kullanıcı eylemiyle değişir. "Yolda" ve "tarihi geçti"
/// durumları saklanmaz; tarihlerden hesaplanır (bkz. src/lib/plan.ts).
enum PlanStatus {
  PLANNED
  CANCELLED
  DONE
}

enum DaySlot {
  MORNING
  NOON
  EVENING
}

enum BudgetCategory {
  TRANSPORT
  ACCOMMODATION
  FOOD
  ACTIVITIES
  SHOPPING
  OTHER
}

enum BudgetKind {
  /// Planın öngördüğü gider (AI tahmini ya da manuel planın hesabı)
  ESTIMATE
  /// Kullanıcının kaydettiği gerçek harcama
  EXPENSE
}

model Plan {
  id     String     @id @default(cuid())
  userId String
  source PlanSource
  status PlanStatus @default(PLANNED)

  // Rota
  city      String
  country   String?
  latitude  Float?
  longitude Float?
  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date
  travelers Int       @default(1)

  // Tercihler
  travelStyle     String?
  budgetLevel     String?
  interests       String[]
  transportPrefs  String[]
  stayPreference  String?
  specialRequests String?

  // Rehber metinleri (markdown)
  cityGuide     String?
  foodGuide     String?
  practicalInfo String?

  // Seçilen ulaşım / konaklama (manuel planlar)
  transport     Json?
  accommodation Json?

  // Bütçe
  currency     String @default("TRY")
  totalCost    Float?
  targetBudget Float?

  // Üretim bilgisi
  aiModel String?

  // Yapılandırılmış veriye geçmeden önce üretilmiş planların metinleri.
  // Yeni planlarda boştur; arayüz yalnızca `days` boşsa bunlara döner.
  legacyDayPlan String?
  legacyBudget  String?
  legacyRaw     String?

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  days        PlanDay[]
  budgetLines BudgetLine[]

  @@index([userId, createdAt])
  @@index([userId, status])
}

model PlanDay {
  id        String  @id @default(cuid())
  planId    String
  dayNumber Int
  title     String?
  notes     String?
  isFree    Boolean @default(false)

  plan  Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  stops PlanStop[]

  @@unique([planId, dayNumber])
}

model PlanStop {
  id          String   @id @default(cuid())
  dayId       String
  position    Int
  name        String
  description String?
  slot        DaySlot?
  startTime   String?
  endTime     String?
  cost        Float?
  category    String?
  latitude    Float?
  longitude   Float?

  day PlanDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([dayId, position])
}

model BudgetLine {
  id          String         @id @default(cuid())
  planId      String
  kind        BudgetKind
  category    BudgetCategory
  description String
  amount      Float
  isPaid      Boolean        @default(false)
  createdAt   DateTime       @default(now())

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, kind])
}

/// Şehir kapak fotoğrafı önbelleği (Wikipedia). Bulunamayanlar da boş olarak
/// kaydedilir ki her istekte yeniden sorulmasın.
model CityCover {
  query     String   @id
  imageUrl  String?
  pageUrl   String?
  createdAt DateTime @default(now())
}

/// Şehir koordinatları önbelleği: aynı şehir için dış servise tekrar gidilmez.
model GeoCache {
  query     String   @id
  name      String?
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
}
