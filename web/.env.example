# Bu dosyayı ".env" adıyla kopyalayıp değerleri doldurun:  cp .env.example .env
# (Prisma CLI yalnızca ".env" dosyasını okur.)

# --- Zorunlu ---
# docker-compose.yml içindeki yerel veritabanı için hazır değer:
DATABASE_URL="postgresql://trip:trip@localhost:5432/tripplanner"
NEXTAUTH_URL="http://localhost:3000"
# Üretmek için:  openssl rand -base64 32
NEXTAUTH_SECRET=""

# --- AI plan üretimi (isteğe bağlı) ---
# Anahtar yoksa uygulama çalışır; yalnızca "AI ile planla" kapalı olur.
OPENROUTER_API_KEY=""
# Yapılandırılmış (JSON) çıktı üretebilen bir model seçin. Varsayılan ücretsiz model
# küçük olduğu için sık sık geçersiz yanıt verebilir.
# OPENROUTER_MODEL="deepseek/deepseek-r1-0528-qwen3-8b:free"
# OpenAI uyumlu başka bir uç kullanmak için:
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# --- Google ile giriş (isteğe bağlı; ikisi de doluysa etkinleşir) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Şehir koordinatı (Nominatim) ---
# Nominatim kullanım koşulları uygulamayı tanıtan bir User-Agent ister;
# yayına alırken iletişim bilgisi içeren bir değer verin.
# GEOCODER_USER_AGENT="TripPlanner/1.0 (iletisim@ornek.com)"
